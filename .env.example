# Local Docker/default development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production behind Nginx should use the public HTTPS domain, for example:
# NEXT_PUBLIC_API_BASE_URL=https://fm.example.com
FRONTEND_PORT=3000
# Optional comma-separated browser origins. Production should use the public HTTPS domain.
# FM_CORS_ALLOW_ORIGINS=https://fm.example.com
# Set to 1 when HTTPS is terminated by Nginx in production.
FM_SESSION_COOKIE_SECURE=0

FM_RUNTIME_DIR=/app/.runtime
FM_UPLOAD_DIR=/app/.runtime/uploads
FM_SQLITE_PATH=/app/.runtime/app.sqlite3
FM_KNOWLEDGE_ROOT=/app/knowledge
FM_EXTERNAL_TRUST_SHARED_SECRET=change-this-shared-secret
FM_RAG_ENABLED=1
FM_RAG_INDEX_DIR=/app/backend/app/data/rag_index
FM_RAG_MODEL_PATH=/models/bge-m3
# Optional: use the configured LLM to naturalize already-filtered RAG snippets
# into customer-facing report sections. Disable to force deterministic local fusion.
FM_RAG_LLM_FUSION_ENABLED=1
# Host-side model directory for Docker Compose. Keep this outside the Git repo.
FM_RAG_MODEL_HOST_DIR=./bge-m3
FM_RAG_LOCAL_FILES_ONLY=1
HF_HOME=/app/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional: only set this if you provide a local reference PDF outside Git.
# FM_REPORT_REFERENCE_PATH=/app/report-reference.pdf

# LLM config used by asynchronous case analysis and optional report composition.
# Doubao/Ark Responses example:
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=your-ark-api-key
# LLM_MODEL=doubao-seed-2-0-mini-260215
# LLM_API_STYLE=responses
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_STYLE=auto
LLM_TIMEOUT_SECONDS=90
LLM_THINKING_TIMEOUT_SECONDS=600
LLM_TEMPERATURE=0.1
FM_MAX_UPLOAD_MB=50
FM_MAX_PDF_PAGES=200
FM_ANALYSIS_WORKERS=1
# Keep original draft/report generation rule-based by default.
# The LLM may still be used by the RAG fusion layer above.
FM_LLM_DRAFT_COMPOSER_ENABLED=0
