# Next.js uses this server-only address to reach FastAPI.
# Docker Compose defaults to http://backend:8000; local `npm run dev` defaults to http://127.0.0.1:8000.
# INTERNAL_API_BASE_URL=http://backend:8000
# FM_API_V2_BEARER_TOKEN=由服务端预签发的对接访问令牌
# 仅限 `next dev` 的虚构前端验收模式；生产构建会强制关闭。
# FM_WORKFLOW_FIXTURE_MODE=0
# FM_WORKFLOW_FIXTURE_SCENARIO=success
# Optional public origin used when the external API returns absolute download URLs.
# FM_PUBLIC_BASE_URL=https://fm.example.com
# 配置说明：分析服务后端宿主机排障端口；Compose 仅绑定 127.0.0.1，浏览器不直接访问。
BACKEND_PORT=7800
# 配置说明：分析服务前端宿主机端口；普通 Compose 由宿主机代理访问，服务器 Compose 则由 Nginx 提供此公共入口。
FRONTEND_PORT=3100
# 本文件只保存分析服务配置。集成 Compose、网关和桥接位于业务系统仓库。
# 集成部署先读取本仓库 .env，再读取业务系统 .env.development.local；不使用 NEXT_PUBLIC_API_BASE_URL。
# Optional comma-separated browser origins. Production should use the public HTTPS domain.
# FM_CORS_ALLOW_ORIGINS=https://fm.example.com
# Set to 1 when HTTPS is terminated by Nginx in production.
# 配置说明：会话 Cookie 安全开关：HTTP 本地/内网为 0，HTTPS 为 1；当前 HTTP 集成 Compose 固定为 0。
FM_SESSION_COOKIE_SECURE=0

# 配置说明：容器内运行目录，通常 /app/.runtime；宿主机运行需改成本机路径，不是 Docker 挂载源路径。
FM_RUNTIME_DIR=/app/.runtime
# 配置说明：上传附件在容器内的保存目录，通常 /app/.runtime/uploads，随运行目录持久化。
FM_UPLOAD_DIR=/app/.runtime/uploads
# 配置说明：SQLite 数据库的容器内完整文件路径，通常 /app/.runtime/app.sqlite3；不能随意更换或清空。
FM_SQLITE_PATH=/app/.runtime/app.sqlite3
# 配置说明：知识资料的容器内目录，通常 /app/knowledge，对应宿主机 knowledge 只读挂载。
FM_KNOWLEDGE_ROOT=/app/knowledge
# 配置说明：旧外部 API 的系统间共享密钥；仅服务端保存，与 Joolun 嵌入签名密钥用途不同。
FM_EXTERNAL_TRUST_SHARED_SECRET=
# 配置说明：本地 RAG 知识检索开关，1 开启、0 关闭；开启需完整模型权重及检索索引。
FM_RAG_ENABLED=1
# 配置说明：RAG 检索索引的容器内目录，通常 /app/backend/app/data/rag_index。
FM_RAG_INDEX_DIR=/app/backend/app/data/rag_index
# 配置说明：容器内嵌入模型路径，通常 /models/bge-m3；不同于宿主机挂载源路径。
FM_RAG_MODEL_PATH=/models/bge-m3
# Optional: use the configured LLM to naturalize already-filtered RAG snippets
# into customer-facing report sections. Disable to force deterministic local fusion.
# 配置说明：RAG 片段是否由模型整理为报告文字，1 开启、0 使用确定性本地融合；开启会消耗模型额度。
FM_RAG_LLM_FUSION_ENABLED=1
# Host-side model directory for Docker Compose. Keep this outside the Git repo.
# 宿主机模型目录，相对于分析服务仓库；集成 Compose 会拼接业务系统 AI_REPO_DIR，不填写绝对路径。
FM_RAG_MODEL_HOST_DIR=bge-m3
# 配置说明：1 表示只加载本地模型文件，不尝试从网络下载；权重缺失时应核对模型目录。
FM_RAG_LOCAL_FILES_ONLY=1
# 配置说明：容器内 Hugging Face 缓存目录，通常 /app/.cache/huggingface。
HF_HOME=/app/.cache/huggingface
# 配置说明：容器内 sentence-transformers 缓存目录，通常与 Hugging Face 缓存保持一致。
SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface
# 配置说明：1 禁止 Hugging Face 在线下载，需要完整本地模型；0 允许联网获取。
HF_HUB_OFFLINE=1
# 配置说明：1 让 Transformers 离线加载模型，部署时通常与 HF_HUB_OFFLINE 一致。
TRANSFORMERS_OFFLINE=1

# Optional: only set this if you provide a local reference PDF outside Git.
# FM_REPORT_REFERENCE_PATH=/app/report-reference.pdf

# LLM config used by asynchronous case analysis and optional report composition.
# Keep the real API key only in the ignored local .env or the deployment secret store.
# 配置说明：模型服务 API 基址，例如供应商的 /v1 地址；由服务器访问，不是分析服务页面地址。
LLM_BASE_URL=https://api.moonshot.cn/v1
# 配置说明：模型供应商鉴权 Key，仅保存在忽略 Git 的运行配置中；不是 Base URL，也不是 Joolun 共享密钥。
LLM_API_KEY=
# 配置说明：供应商实际支持的模型名称，需与 LLM_BASE_URL、API Key 对应。
LLM_MODEL=kimi-k2.6
# 配置说明：模型 API 协议方式，例如 chat/auto；按当前模型供应商和应用支持的接口填写。
LLM_API_STYLE=chat
# 配置说明：普通模型调用超时（秒）；过短可能导致文件分析请求超时。
LLM_TIMEOUT_SECONDS=300
# 配置说明：模型深度思考调用超时（秒），通常大于普通调用超时。
LLM_THINKING_TIMEOUT_SECONDS=600
# 配置说明：模型生成随机度；通常 0–1，较低更稳定，按既有业务配置保留。
LLM_TEMPERATURE=0.6
# 配置说明：模型请求可重试错误的重试次数；过高会增加等待时间和模型调用。
FM_LLM_RETRY_ATTEMPTS=2
# 配置说明：模型重试的基础退避等待时间（秒）。
FM_LLM_RETRY_BASE_DELAY_SECONDS=1
# 配置说明：模型重试等待上限（秒）。
FM_LLM_RETRY_MAX_DELAY_SECONDS=10
# 配置说明：同时进行的模型调用上限，需结合供应商配额和服务器资源；本地部署默认 4。
FM_LLM_MAX_CONCURRENCY=4
# 配置说明：模型每分钟请求数的软限额，按供应商实际 RPM 配额设置。
FM_LLM_RPM_SOFT_LIMIT=475
# 配置说明：模型每分钟 token 总量软限额，按供应商实际 TPM 配额设置。
FM_LLM_TPM_SOFT_LIMIT=2850000
# 配置说明：模型调用配额统计窗口（秒），通常 60。
FM_LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Admission reservation only; this is not sent to Kimi as an output limit.
# 配置说明：模型并发准入的预计输出 token 预留量，不是发给模型的输出截断参数。
FM_LLM_DEFAULT_COMPLETION_RESERVATION=32768
# 配置说明：单个上传文件上限（MiB），默认 50；不等于整批上传上限。
FM_MAX_UPLOAD_MB=50
# 配置说明：一次批量上传的文件数量上限，默认 10。
FM_MAX_UPLOAD_FILES_PER_BATCH=10
# 配置说明：一次批量上传总大小上限（MiB），默认 100；代理额外保留 multipart 开销。
FM_MAX_UPLOAD_BATCH_MB=100
# 配置说明：单个 PDF 最大页数，默认 50，超过需要用户拆分后上传。
FM_MAX_PDF_PAGES=50
# 配置说明：病例分析后台工作线程数，按 CPU/内存设置；建议初始值为 2。
FM_ANALYSIS_WORKERS=2
# 配置说明：一个病例内并行处理文件的数量，本地默认 2，会影响模型并发及内存。
FM_CASE_DOCUMENT_WORKERS=2
# Keep original draft/report generation rule-based by default.
# The LLM may still be used by the RAG fusion layer above.
# 配置说明：草案/报告模型编排开关，默认 0 使用规则；RAG 融合开关与此项独立。
FM_LLM_DRAFT_COMPOSER_ENABLED=0

# 分析服务浏览器公共地址；服务器示例为下值，本地用 http://127.0.0.1:3100。
FM_PUBLIC_BASE_URL=http://172.16.0.140:3100

# 分析服务验证换票签名的私有密钥，至少 32 字符；与业务系统同名变量一致，真实值不提交。
FM_JOOLUN_EMBED_SHARED_SECRET=

# 宿主机持久化数据目录，相对于分析服务仓库。必须确认已有目录，禁止两后端同时写同一数据库。
FM_RUNTIME_HOST_DIR=.runtime

# 构建时预下载模型开关；已挂载宿主机模型时用 0。
PRELOAD_RAG_MODEL=0

# 分析服务换票接口开关，1 启用。
FM_JOOLUN_EMBED_ENABLED=1

# 分析服务 iframe 公共基址，必须与 FM_PUBLIC_BASE_URL 和业务系统 VITE_FM_EMBED_ORIGIN 一致。
FM_JOOLUN_EMBED_BASE_URL=http://172.16.0.140:3100

# 分析服务允许嵌入的精确父页面 Origin，多个值逗号分隔；本地填写实际网关及需要的 Vite Origin。
FM_JOOLUN_EMBED_ALLOWED_PARENT_ORIGINS=http://172.16.0.140:7600

# Next.js 服务端访问 FastAPI 的地址；集成容器固定使用 http://backend:8000。
INTERNAL_API_BASE_URL=http://backend:8000
