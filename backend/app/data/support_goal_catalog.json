{
  "version": "support-goals-v5-digestive-products-2026-07-22",
  "goals": [
    {"code":"gut_bile","name":"肝胆与脂肪消化支持","definition":"支持胆汁分泌、脂肪消化与肝胆消化协同。","system_id":"digestive_gut","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["nodule","mass","antibody_only"]},
    {"code":"gut_microbiome","name":"肠道菌群生态支持","definition":"支持存在明确菌群结构、致病菌或代谢产物异常时的肠道生态调整。","system_id":"digestive_gut","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["food_sensitivity"]},
    {"code":"gut_mucosa","name":"胃肠黏膜与屏障支持","definition":"支持胃肠黏膜、屏障完整性和黏膜免疫相关需求。","system_id":"digestive_gut","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["food_sensitivity"]},
    {"code":"gastric_acid","name":"胃酸分泌支持","definition":"仅支持有明确胃酸分泌不足、低胃酸或蛋白质胃内初步消化不足证据的需求。","system_id":"digestive_gut","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["food_sensitivity"],"eligible_directions":["increase","restore"]},
    {"code":"digestive_enzyme","name":"消化酶与营养吸收支持","definition":"支持有明确消化酶、全食物分解、餐后消化负担或营养吸收不足证据的需求；不用于替代胃酸分泌支持。","system_id":"digestive_gut","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["food_sensitivity"],"eligible_directions":["increase","restore","maintain"]},
    {"code":"liver_detox","name":"肝脏代谢与抗氧化支持","definition":"支持存在明确肝胆代谢或生物转化负担证据时的营养需求。","system_id":"liver_detox","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["cancer_risk"]},
    {"code":"methylation","name":"甲基化与同型半胱氨酸支持","definition":"支持同型半胱氨酸、叶酸与维生素B族相关甲基化需求。","system_id":"cardiovascular","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":[]},
    {"code":"immune","name":"免疫功能支持","definition":"支持有明确免疫功能、感染易感或黏膜免疫证据的营养需求。","system_id":"immune_inflammation","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["antibody_only","tumor_marker"]},
    {"code":"inflammation","name":"炎症平衡支持","definition":"支持有明确炎症指标、炎症性检查结论或多来源炎症症状的需求。","system_id":"immune_inflammation","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["tumor_marker"]},
    {"code":"antioxidant","name":"抗氧化与恢复支持","definition":"支持有明确氧化压力、恢复负担或相关代谢证据的需求。","system_id":"immune_inflammation","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["cancer_risk"]},
    {"code":"thyroid_axis","name":"甲状腺营养支持","definition":"支持有明确甲状腺功能异常或临床结论时的营养需求。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":["antibody_only","nodule"]},
    {"code":"glycemic_balance","name":"血糖稳定支持","definition":"仅支持存在血糖、糖化血红蛋白、胰岛素或明确糖代谢异常证据的需求。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":["enzyme_name_similarity"]},
    {"code":"weight_metabolism","name":"体重与脂肪代谢支持","definition":"仅支持体重偏高、腰围偏高或明确减脂目标；体重偏低或增重需求只能保留为病例叙述。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["underweight"],"blocked_finding_codes":["underweight"],"eligible_directions":["decrease"]},
    {"code":"nutrition_repletion","name":"体重过轻与营养恢复支持","definition":"支持BMI偏低、体重过轻或明确营养摄入不足时的基础营养、消化吸收和稳妥体重恢复需求。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":[],"eligible_directions":["increase","restore"]},
    {"code":"vitamin_d_repletion","name":"维生素D补充支持","definition":"支持25-羟维生素D不足或缺乏以及与其相关的骨骼免疫需求。","system_id":"bone_muscle","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":[],"must_cover_when_direct":true},
    {"code":"hormone_axis","name":"内分泌激素节律支持","definition":"支持有明确激素检测或临床结论的内分泌节律需求。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":["mass","nodule"]},
    {"code":"female_hormone","name":"女性激素节律支持","definition":"支持女性周期、围绝经或明确女性激素检测相关需求。","system_id":"reproductive_breast","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["breast_mass","birads"]},
    {"code":"cardiovascular","name":"心血管功能支持","definition":"支持有明确血压、心电、心肌或血管风险证据的营养需求。","system_id":"cardiovascular","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["genetic_risk_only"]},
    {"code":"lipid_balance","name":"血脂代谢支持","definition":"支持血脂、载脂蛋白或明确脂质代谢异常相关需求。","system_id":"cardiovascular","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":[]},
    {"code":"sleep_stress","name":"睡眠与压力恢复支持","definition":"支持医生总结、有效MSQ或多来源症状明确记录的睡眠与压力需求。","system_id":"neuro_sleep","allowed_evidence_types":["contextual","explicit_conclusion"],"blocked_standalone_finding_types":[]},
    {"code":"neuro_cognitive","name":"神经认知支持","definition":"支持有明确认知、神经系统检查或多来源相关症状的需求。","system_id":"neuro_sleep","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":[]},
    {"code":"energy_mitochondria","name":"细胞能量与疲劳恢复支持","definition":"支持医生总结或多来源证据明确的疲劳、体力与能量恢复需求。","system_id":"neuro_sleep","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":[]},
    {"code":"bone_metabolism","name":"骨代谢支持","definition":"支持骨量减少、骨密度异常或明确骨代谢检查证据。","system_id":"bone_muscle","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":[]},
    {"code":"iron_repletion","name":"铁利用与造血支持","definition":"支持铁蛋白、血清铁、血红蛋白等明确缺铁或造血证据。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":[],"must_cover_when_direct":true},
    {"code":"foundational","name":"基础营养支持","definition":"仅在明确多种基础营养素不足或营养摄入不足证据下使用。","system_id":"endocrine_metabolic","allowed_evidence_types":["direct","explicit_conclusion","contextual"],"blocked_standalone_finding_types":["single_vague_symptom"]},
    {"code":"anti_aging","name":"健康老化与恢复支持","definition":"仅作为明确氧化压力和恢复证据的次要支持目标，不以宣传性风险描述触发。","system_id":"immune_inflammation","allowed_evidence_types":["direct","explicit_conclusion"],"blocked_standalone_finding_types":["cancer_risk","genetic_risk_only"]}
