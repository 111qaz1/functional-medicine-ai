# Include inside the EXISTING 8600 server, before the Vue location / fallback.
# Keep its TLS certificate, Vue root, /prod-api and Java upstream unchanged.
# Install fm-next-proxy.conf.example as /etc/nginx/snippets/fm-next-proxy.conf.
# Remove conflicting locations for these prefixes before adding this include.
# Exact matches plus ^~ prevent generic JS/CSS regex locations from intercepting Next.js.

location = /integration/embed {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}
location ^~ /integration/embed/ {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}

location = /_next {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}
location ^~ /_next/ {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}

location = /api/internal/health {
    limit_except GET { deny all; }
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}
location = /api/internal { return 404; }
location ^~ /api/internal/ { return 404; }

location = /api/v2 {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}
location ^~ /api/v2/ {
    include /etc/nginx/snippets/fm-next-proxy.conf;
    proxy_set_header X-FM-Entry public;
}

location = /api/v1 { return 404; }
location ^~ /api/v1/ { return 404; }
