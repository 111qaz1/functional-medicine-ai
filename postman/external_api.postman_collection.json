{
  "info": {
    "_postman_id": "54b12664-1676-4fd7-8d68-fm-external-api",
    "name": "功能医学外部接口全流程验证",
    "description": "系统间授信外部接口测试集合。医生身份由甲方系统签名声明，工作台仅校验签名并签发 Bearer token。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 系统签名换取医生 Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const issuer = pm.environment.get('issuer');",
              "const doctorId = pm.environment.get('doctor_id');",
              "const doctorName = pm.environment.get('doctor_name');",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = `nonce-${Date.now()}`;",
              "const canonical = [issuer, doctorId, doctorName, timestamp, nonce].join('\\n');",
              "const signature = CryptoJS.HmacSHA256(canonical, pm.environment.get('shared_secret')).toString(CryptoJS.enc.Hex);",
              "pm.environment.set('timestamp', timestamp);",
              "pm.environment.set('nonce', nonce);",
              "pm.environment.set('signature', signature);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('系统授信换取 Token 成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.test('返回 Bearer Token', function () {",
              "  pm.expect(payload.token_type).to.eql('bearer');",
              "  pm.expect(payload.access_token).to.be.a('string').and.not.empty;",
              "});",
              "pm.environment.set('access_token', payload.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"issuer\": \"{{issuer}}\",\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"doctor_name\": \"{{doctor_name}}\",\n  \"timestamp\": {{timestamp}},\n  \"nonce\": \"{{nonce}}\",\n  \"signature\": \"{{signature}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. 创建外部病例",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('病例创建成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.case_id).to.be.a('string').and.not.empty;",
              "pm.environment.set('case_id', payload.case_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Postman外部接口测试\",\n  \"consultant_id\": \"{{doctor_name}}\",\n  \"notes\": \"Postman collection smoke test\",\n  \"analysis_mode\": \"llm_primary\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/cases",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "cases"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. 上传病例附件",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('附件上传并完成初始解析', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.results[0].status).to.eql('parsed');",
              "pm.expect(payload.results[0].lab_item_count).to.be.above(0);",
              "pm.test('未知指标进入人工校对提示', function () {",
              "  pm.expect(payload.results[0].parse_warnings.join('\\n')).to.include('载脂蛋白E');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "attachment_type",
              "value": "case",
              "type": "text"
            },
            {
              "key": "files",
              "type": "file",
              "src": "postman/fixtures/labs.txt"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/cases/{{case_id}}/attachments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "cases",
            "{{case_id}}",
            "attachments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. 读取解析校对内容",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('读取解析校对内容成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.revision).to.be.a('number');",
              "pm.expect(payload.files).to.be.an('array').and.not.empty;",
              "pm.environment.set('parsing_revision', payload.revision.toString());",
              "pm.environment.set('parsing_files', JSON.stringify(payload.files.map(function (item) { return { file_id: item.file_id, corrected_text: item.corrected_text, missing_fields: item.missing_fields }; })));",
              "pm.environment.set('lab_items', JSON.stringify(payload.normalized_lab_items));",
              "pm.environment.set('specialty_reports', JSON.stringify(payload.specialty_reports));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/cases/{{case_id}}/parsing-review",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cases", "{{case_id}}", "parsing-review"]
        }
      },
      "response": []
    },
    {
      "name": "5. 保存解析校对",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('解析校对保存成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.review_completed).to.eql(true);",
              "pm.expect(payload.revision).to.eql(Number(pm.environment.get('parsing_revision')) + 1);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_revision\": {{parsing_revision}},\n  \"files\": {{parsing_files}},\n  \"normalized_lab_items\": {{lab_items}},\n  \"specialty_reports\": {{specialty_reports}},\n  \"missing_fields\": [],\n  \"review_notes\": \"Postman 自动化校对验证\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/cases/{{case_id}}/parsing-review",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cases", "{{case_id}}", "parsing-review"]
        }
      },
      "response": []
    },
    {
      "name": "6. 生成营养素推荐草案",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('营养素推荐草案生成成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.draft_id).to.be.a('string').and.not.empty;",
              "pm.expect(payload.manual_review_required).to.eql(true);",
              "pm.expect(payload.recommendations).to.be.an('array');",
              "pm.environment.set('draft_id', payload.draft_id);",
              "pm.environment.set('draft_revision', payload.revision.toString());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/cases/{{case_id}}/nutrition-recommendations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "cases",
            "{{case_id}}",
            "nutrition-recommendations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. 读取可编辑营养素草案",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('读取待审营养素草案成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.editable_fields).to.include('recommendations.dosage');",
              "pm.expect(payload.recommendations).to.be.an('array').and.not.empty;",
              "pm.environment.set('draft_revision', payload.revision.toString());",
              "const editable = payload.recommendations.slice(0, 2).map(function (item) { return { sku_id: item.sku_id, dosage: item.dosage, reason: item.reason }; });",
              "pm.environment.set('draft_recommendations', JSON.stringify(editable));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": {
          "raw": "{{base_url}}/api/v1/drafts/{{draft_id}}/nutrition-recommendations",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "drafts", "{{draft_id}}", "nutrition-recommendations"]
        }
      },
      "response": []
    },
    {
      "name": "8. 修改待审营养素草案",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('草案修改成功并递增版本', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.revision).to.eql(Number(pm.environment.get('draft_revision')) + 1);",
              "pm.expect(payload.recommendations).to.be.an('array').and.not.empty;",
              "pm.environment.set('draft_revision', payload.revision.toString());"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_revision\": {{draft_revision}},\n  \"recommendations\": {{draft_recommendations}},\n  \"edit_reason\": \"Postman 自动化编辑验证\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/drafts/{{draft_id}}/nutrition-recommendations",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "drafts", "{{draft_id}}", "nutrition-recommendations"]
        }
      },
      "response": []
    },
    {
      "name": "9. 获取处方级总医嘱",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('处方级总医嘱返回成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const payload = pm.response.json();",
              "pm.expect(payload.case_id).to.eql(pm.environment.get('case_id'));",
              "pm.expect(payload.draft_id).to.eql(pm.environment.get('draft_id'));",
              "pm.expect(payload).to.not.have.property('course_period_default');",
              "pm.expect(payload).to.not.have.property('items');",
              "pm.expect(payload).to.not.have.property('dosage');",
              "pm.expect(payload.medical_advice).to.be.a('string').and.not.empty;",
              "pm.expect(payload.medical_advice.length).to.be.within(50, 100);",
              "pm.expect(['llm', 'local_fallback']).to.include(payload.advice_source);",
              "const serialized = JSON.stringify(payload);",
              "['关联度', '命中产品标签', 'RAG内部审查', 'product:', 'statement_', '?????', 'API Key', '治疗', '治愈', '疗效'].forEach(function (term) {",
              "  pm.expect(serialized).to.not.include(term);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/drafts/{{draft_id}}/prescription-items",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "drafts",
            "{{draft_id}}",
            "prescription-items"
          ]
        }
      },
      "response": []
    },
    {
      "name": "10. 未审核报告下载被拦截",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('未审核报告返回 409', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/drafts/{{draft_id}}/report-download",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "drafts",
            "{{draft_id}}",
            "report-download"
          ]
        }
      },
      "response": []
    }
  ]
}
